{
  "name": "kinage-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "description": "Kinage landing page, Our Story and For Advisors — Figma 596:1908 (hero) and 583:518 with the Kinage design library and motion; published with GitHub Pages.",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "predev": "node scripts/build-tokens.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check": "npm run tokens:check && npm run brand:check && node scripts/derive-hero-arcs.mjs --check && npm run typecheck",
    "prebuild": "npm run check",
    "build": "vite build",
    "preview": "vite preview",
    "build:pages": "npm run check && node scripts/pages.mjs build",
    "preview:pages": "node scripts/pages.mjs preview",
    "verify:shots": "node scripts/verify/screenshots.mjs",
    "verify:flight": "node scripts/verify/flight.mjs",
    "verify:interactions": "node scripts/verify/interactions.mjs",
    "verify:record": "node scripts/verify/record-flight.mjs",
    "verify:sections": "node scripts/verify/sections.mjs",
    "verify:refinements": "node scripts/verify/refinements.mjs",
    "verify:record-nav": "node scripts/verify/record-nav.mjs",
    "verify:clips": "node scripts/verify/record-clips.mjs",
    "brand": "node scripts/build-brand.mjs --png",
    "brand:check": "node scripts/build-brand.mjs --check",
    "arcs": "node scripts/derive-hero-arcs.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}

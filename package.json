{
  "name": "kinage-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kinage website: the landing page, Our Story and For Advisors, published with GitHub Pages.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "predev": "node scripts/build-tokens.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check": "npm run tokens:check && npm run typecheck",
    "prebuild": "npm run check",
    "build": "vite build",
    "preview": "vite preview",
    "build:pages": "npm run check && node scripts/pages.mjs build",
    "preview:pages": "node scripts/pages.mjs preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
